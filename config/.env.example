# ---------------------------------------------------------------------------
# HelpWise (Cobalt Dynamics) — environment overrides.
#
# This is NOT the full LibreChat .env — it's the subset of keys we changed
# from LibreChat's own .env.example for the reskin + Google Gemini backend.
#
# HOW TO USE:
#   1. Copy LibreChat's own .env.example -> .env  (the installer does this)
#   2. Paste/merge the lines below into that .env, replacing the matching keys
#   3. Fill in GOOGLE_KEY with your own free Gemini API key from
#      https://aistudio.google.com/app/apikey  — NEVER commit this file with
#      a real key in it. Keep real secrets in a local .env that is gitignored.
# ---------------------------------------------------------------------------

# --- Identity (reskin requirement #1) ---------------------------------------
APP_TITLE=HelpWise
CUSTOM_FOOTER="HelpWise — Cobalt Dynamics internal IT helpdesk assistant (student project, invented data only)"
HELP_AND_FAQ_URL=https://example.com/cobalt-dynamics-it-helpdesk

# --- Model backend: Google Gemini, free tier ---------------------------------
GOOGLE_KEY=REPLACE_WITH_YOUR_FREE_GEMINI_API_KEY
GOOGLE_MODELS=gemini-2.0-flash-001,gemini-2.0-flash-lite-001

# --- Config file: points LibreChat at our librechat.yaml --------------------
# (wired via the bind mount in docker-compose.override.yml, not an env var)

# --- Secrets required by LibreChat itself (generate your own, don't reuse) --
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDS_KEY=REPLACE_WITH_32_BYTE_HEX
CREDS_IV=REPLACE_WITH_16_BYTE_HEX
JWT_SECRET=REPLACE_WITH_RANDOM_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_RANDOM_STRING
ADMIN_PANEL_SESSION_SECRET=REPLACE_WITH_RANDOM_STRING

# --- Registration: single operator, no public signup for a student project --
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false
